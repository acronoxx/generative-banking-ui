# Copy this file to .env and fill in the values. Never commit .env.

# Model (IMT gateway, OpenAI-compatible)
OPENAI_API_KEY=your-subscription-key
OPENAI_BASE_URL=https://ai-gateway-imt.azure-api.net/projets-imt/openai/v1/
OPENAI_MODEL=gpt-6-luna

# Backend MCP server
BACKEND_MCP_URL=http://127.0.0.1:8000/mcp

# AG-UI server port
AGENT_PORT=8001

# LangSmith traces (shared team account)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
