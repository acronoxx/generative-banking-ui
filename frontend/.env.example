# Copy this file to .env and adjust the values.

# Read by the page (Vite): only VITE_ variables are visible in the browser,
# and they are public. Never put a secret here.
VITE_RUNTIME_URL=http://localhost:4000/api/copilotkit

# Read by the CopilotKit runtime (runtime.ts, server side)
RUNTIME_PORT=4000
AGENT_URL=http://127.0.0.1:8001/
# Disables the usage statistics the runtime sends to CopilotKit by default
COPILOTKIT_TELEMETRY_DISABLED=true
