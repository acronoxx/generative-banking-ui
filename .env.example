# Copier ce fichier en .env et remplir. Le fichier .env n'est JAMAIS commit (cf. .gitignore).
AZURE_API_BASE=https://<ressource>.openai.azure.com/
AZURE_API_KEY=<cle fournie par Sopra - ne pas partager ni commit>
AZURE_API_VERSION=<version d'API fournie par Sopra>
# Noms de DEPLOIEMENT (pas forcement le nom du modele) :
LLM_DEPLOYMENT_LUNA=<nom du deploiement GPT-6 Luna>
# Modeles de comparaison (phase 2, quand Sopra les a actives) :
# LLM_DEPLOYMENT_SOL=<nom du deploiement GPT-6 Sol>
# LLM_DEPLOYMENT_OTHER=<autre fournisseur>
# AZURE_OTHER_API_BASE=...
# AZURE_OTHER_API_KEY=...
BENCH_STRICT_UI=1
